# Copy to .env and adjust. .env is git-ignored - never commit real secrets.

# --- Platform runtime ---
# RCA_ENVIRONMENT: development | testing | staging | production
RCA_ENVIRONMENT=development
RCA_DEBUG=false
RCA_API_HOST=0.0.0.0
RCA_API_PORT=8000
# RCA_LOG_LEVEL: DEBUG | INFO | WARNING | ERROR | CRITICAL
RCA_LOG_LEVEL=INFO
# RCA_LOG_FORMAT: text | json
RCA_LOG_FORMAT=text

# --- Configuration files ---
# RCA_CONFIG_DIR=config
# RCA_APP_CONFIG_PATH=config/applications/<your-app>.yaml
# RCA_APPLICATION_NAME=

# --- Telemetry endpoints (referenced from YAML via ${VAR}) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=
# RCA_METRICS_ENDPOINT=
# RCA_LOGS_ENDPOINT=
# RCA_TRACES_ENDPOINT=

# --- Secrets ---
# RCA_LLM_API_KEY=
# RCA_TELEMETRY_AUTH_TOKEN=
